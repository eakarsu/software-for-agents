DATABASE_URL=postgresql://localhost/agent_services_db
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
PORT=3013

# Required only when grounded agent runs are enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGENT_MAX_OUTPUT_TOKENS=700
AGENT_LATENCY_BUDGET_MS=8000
AGENT_COST_BUDGET_USD=0.05
AGENT_RUNS_PER_MINUTE=20
SOURCE_MAX_STALENESS_MINUTES=1440

# Tool worker policy. Real connector tokens use the CONNECTOR_TOKEN_* namespace.
TOOL_TIMEOUT_MS=5000
TOOL_MAX_ATTEMPTS=3
CONNECTOR_TOKEN_EXAMPLE=
